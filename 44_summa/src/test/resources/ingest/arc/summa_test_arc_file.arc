<script type="text/javascript">
    var minutes = 0;
    var hours = 0;
    var day_of_week = 2;
    var day_of_month = 1;

    function saveScheduleValues(form) {
        if (form.frequency_minutes != null) {
            minutes = form.frequency_minutes.value;
        }
        if (form.frequency_hours != null) {
            hours = form.frequency_hours.value;
        }
        if (form.frequency_day != null) {
            day_of_week = form.frequency_day.value;
        }
        if (form.frequency_date != null) {
            day_of_month = form.frequency_date.value;
        }
    }

    function restoreScheduleValues(form) {
        if (form.frequency_minutes != null) {
            form.frequency_minutes.value = minutes;
        }
        if (form.frequency_hours != null) {
            form.frequency_hours.value = hours;
        }
        if (form.frequency_day != null) {
            form.frequency_day.value = day_of_week;
        }
        if (form.frequency_date != null) {
            form.frequency_date.value = day_of_month;
        }
    }

    function check(s) {
        document.getElementById(s).checked=true;
    }

    /**
    * Attach calendars to the two input fields for the edit-calendar page
    * @param The time format for the calendar.
    */
    function addCalendars(timeFormat){
        Calendar.setup({
            inputField     :    "howOftenField",
                                               // id of the input field
            ifFormat       :    timeFormat,    // format of the input field
            showsTime      :    true,          // will display a time selector
            singleClick    :    true,          // single-click mode
            step           :    1,             // show all years in drop-down
                   // boxes (instead of every other year as default)
            firstDay       :    1              // first day is monday
        });

        Calendar.setup({
            inputField     :    "endTimeField",
                                               // id of the input field
            ifFormat       :    timeFormat,    // format of the input field
            showsTime      :    true,          // will display a time selector
            singleClick    :    true,          // single-click mode
            step           :    1,             // show all years in drop-down
                   // boxes (instead of every other year as default)
            firstDay       :    1              // first day is monday
        });
    }

    /**
    * Attach the calendar to the nextdate field on the edit-harvestdefinition
    * page
    */
    function setupNextdateCalendar(){
        Calendar.setup({
            inputField     :    "nextdate",
                                               // id of the input field
            ifFormat       :    "%d/%m %Y %H:%M",
                                               // format of the input field
            showsTime      :    true,          // will display a time selector
            singleClick    :    true,          // single-click mode
            step           :    1,             // show all years in drop-down
                   // boxes (instead of every other year as default)
            firstDay       :    1              // first day is monday
        });
    }

    function updateTime(select) {
        saveScheduleValues(select.form);

        spanElement = document.getElementById('puttimehere');

        var freq_type;
        for(i=0; i<select.options.length; i++) {
            if (select.options[i].selected == true) {
                freq_type = select.options[i].value;
            }
            //alert(freq_type);
        }
        if (freq_type == 'hours') {
            spanElement.innerHTML = '√Ä la <input type=\"text\" size=\"2\" name=\"frequency_minutes\" id=\"frequency_minutes\" onchange=\"check(\'atime\');\"/>e minute de chaque heure';
        } else if (freq_type == 'days') {
            spanElement.innerHTML = '√† <input type=\"text\" size=\"2\" name=\"frequency_hours\" id=\"frequency_hours\" onchange=\"check(\'atime\');\"/>:<input type=\"text\" size=\"2\" name=\"frequency_minutes\" id=\"frequency_minutes\" onchange=\"check(\'atime\');\"/>';
        } else if (freq_type == 'weeks') {
            spanElement.innerHTML = '√† <input type=\"text\" size=\"2\" name=\"frequency_hours\" id=\"frequency_hours\" onchange=\"check(\'atime\');\"/>:<input type=\"text\" size=\"2\" name=\"frequency_minutes\" id=\"frequency_minutes\" onchange=\"check(\'atime\');\"/> le <select name="frequency_day" id="frequency_day" onchange="check(\'atime\');"><option value=\"2\">Lundi</option><option value=\"3\">Mardi</option><option value=\"4\">Mercredi</option><option value=\"5\">Jeudi</option><option value=\"6\">Vendredi</option><option value=\"7\">Samedi</option><option value=\"1\">Dimanche</option></select>';
        } else if (freq_type == 'months') {
            spanElement.innerHTML = '√† <input type=\"text\" size=\"2\" name=\"frequency_hours\" id=\"frequency_hours\" onchange=\"check(\'atime\');\"/>:<input type=\"text\" size=\"2\" name=\"frequency_minutes\" id=\"frequency_minutes\" onchange=\"check(\'atime\');\"/> le <input type="text" size="2" name="frequency_date" id="frequency_date" onchange="check(\'atime\');\">';
        }
        restoreScheduleValues(select.form);
    }
</script>

<form method="post" action="Definitions-edit-schedule.jsp">

<input type="hidden" name="edition" value="1"/>

<h3>Modifier une p√©riodicit√©</h3>
<input name="update" value="1" type="hidden"/>
<table>
    <tr>
        <td>Intitul√© de la p√©riodicit√© :</td>
        <td><span id="focusElement">
        <input name="name" size="20" value="Once a month" readonly="readonly" type="text"/>
        </span></td>
    </tr>
    <br/><br/>
</table>
Commentaires :<br/>

<textarea name="comments" rows="5" cols="42"></textarea>
<br/><br/>
<table>
<tr>
    <th colspan="2">Lancer la collecte</th>
</tr>
<tr>
    
    <td>Tous/toutes les</td>
    <td><input name="frequency" value="1"
               size="2"/>
        <select name="timespan" id="time_select"
                onchange="updateTime(this);">
            
            <option value="hours"  >heures
            </option>
            <option value="days"  >jours
            </option>
            <option value="weeks"  >semaines
            </option>
            <option value="months"  selected="selected"  >mois
            </option>
        </select>
    </td>
</tr>
<tr>
    <td>Heure pr√©cise :</td>
    
    <td><input type="radio" name="harvestTime"
               value="whenever"  checked="checked"/>√Ä n'importe quelle heure
    </td>
    </tr>
    <tr><td></td>
    <td><input type="radio" name="harvestTime" value="aTime"
               id="atime"  /><span id="puttimehere"/>
    </td>
    
    <script type="text/javascript">
        //Set the appropriate fields for minutes/hours/days/date
        updateTime(document.getElementById('time_select'));
        //Prepopulate those fields
        var minuteEl = document.getElementById('frequency_minutes');
        if (minuteEl != null) {
            minuteEl.value = "0";
        }
        var hourEl = document.getElementById('frequency_hours');
        if (hourEl != null) {
            hourEl.value = "0";
        }
        var dateEl = document.getElementById('frequency_date');
        if (dateEl != null) {
            dateEl.value = "1";
        }
        var dayEl = document.getElementById('frequency_day');
        if (dayEl != null) {
            var dayOptions = dayEl.childNodes;
            for (var i = 0; i < dayOptions.length; i++) {
                if (dayOptions[i].getAttribute("value")
                        == "1") {
                    dayOptions[i].selected = "selected";
                }
            }
        }
    </script>
</tr>
</table>
<br/><br/>
<table>
    <tr>
        <th colspan="2">D√©marrer la collecte</th>
    </tr>
    <tr>
        
        <td><input type="radio" name="beginAt" value="asSoonAsPossible"
                 checked="checked" /></td>
        <td>D√®s que possible</td>
    </tr>
    <tr>
        <td><input type="radio" name="beginAt" value="beginning" id="beginning"
                 /></td>
        <td>√Ä cette date pr√©cise<input name="firstHarvestTime" size="25" id="howOftenField"
                      onChange="check('beginning');"
                
                /><span id="howOften">(Format : JJ/MM AAAA HH:mm)</span></td>
    </tr>
</table>
<br/><br/>

<table>
    <tr>
        <th colspan="3">Continuer la collecte</th>
    </tr>
    
    <tr>
        <td><input type="radio" name="continue" value="forever"  checked="checked" /></td>
        <td colspan="2">Ne jamais l'arr√™ter</td>
    </tr>
    <tr>
        <td><input type="radio" name="continue" value="toTime"
                   id='ending' /></td>
        <td>Jusqu'√† cette date</td>
        <td><input name="endHarvestTime" size="25" id="endTimeField"
                   onChange="check('ending');"
                /><span id="endTime">(Format : JJ/MM AAAA HH:mm)
            </span>
        </td>
    </tr>
    <tr>
        <td><input type="radio" name="continue" value="numberOfHarvests"
                   id="number" /></td>
        <td>
            Jusqu'√† </td><td><input name="numberOfHarvests" size="10" onchange="check('number');"  /> captures
        </td>
    </tr>
</table>
<script type="text/javascript">
    addCalendars('%d/%m %Y %H:%M');
</script>
<br/>
<input type="submit" value="Enregistrer"/>
</form>
</td>
</tr>
</table>
