body {
    font-family: Verdana, Arial, Helvetica, Geneva, sans-serif;
    background-color: #f0f0f0;
}

h1 {
    color: #8b0000;
    font-weight: bold;
    font-size: 240%;
}

h2 {
    color: black;
    font-weight: bold;
    font-size: 140%;
}

h3 {
    font-size:24px;
    font-weight:bold;
    background-color: #ACC8E3;
}

h4 {
    color: black;
    font-weight: bold;
    font-size: 120%;
}

h5 {
    color: black;
    font-weight: bold;
    font-size: 100%;
}

h6 {
    color: black;
    font-weight: bold;
    font-size: 90%;
}

#main_table {
    width:100%;
}

td#menu {
    width: 18em;
    background-color: #cccccc;
}

table#menu_table{
    width: 18em;
    background-color: #cccccc;
}

body,table,tr,td {
    padding:0;
    margin:0;
    border:none;
    vertical-align:text-top;
}

th {
    font-size:16px;
    font-weight:bold;
    background-color: #ACC8E3;
}

tr {
    font-size:12px;
    font-style:normal;
}

tr.row0{
    background-color: #CCCCCC;
}

tr.row1{
    background-color: white;
}

a {
    font-family: verdana, Arial, Helvetica, sans-serif;
    font-size: 14px;
    color: #336699;
}

a:link {
    text-decoration:none ;
}

a:visited {
    text-decoration:none ;
    }

a:hover {
    text-decoration:underline ;
    }

a:active {
    text-decoration:underline ;
    }

h3 a{
    font-size:24px;
    font-weight:bold;
    background-color: #ACC8E3;
}


.selection_table  {
    width:100%;
}

.selection_table th {
    text-align: left;
}

.edit_box{
    border: 2px solid #D4ECFB;
    width: 90%;
    position: relative;
    left:5%;
}

input[type=submit] {
    background-color:#FFFDED;
}

input[name=addDomains] {
    position:relative;
}

[readonly=readonly] {
    background-color:#ACACAC;
}

img {
    border-width: 0;
}

#error_message{
    background-color:#FFFDED;
    font-size: 14pt;
    position:relative;
    left:10%;
    width: 80%;
    border-color:#E9556A;
    border-style:ridge;
    border-width:4pt;
    padding:4pt;

}

#message{
    background-color:#FFFDED;
    font-size: 14pt;
    position:relative;
    left:10%;
    width: 80%;
    border-color:#EAE4EF;
    border-style:ridge;
    border-width:4pt;
    padding:4pt;

}

#message a{
   font-size: 14pt;
}

form.inlineform {
    display: inline;
    font-size: 12pt;
    border-style:none;
}

.languagelinks {
    text-align: right;
}

.systeminfo {
    background-color: #ACC8E3;
    text-align: right;
}

.sidebarHeader {
    font-family: sans-serif;
    font-size: 18pt;
    color: black;
    line-height: 54px;
}

.sidebarHeader:hover {
    text-decoration: none;
}

.sidebarHeader img {
    vertical-align: middle;
}

